# ─────────────────────────────── Contenido ───────────────────────────────
# Fuente de contenido: "static" (archivos en src/content/data) es la única
# implementación por ahora; el selector existe para enchufar un CMS después.
CONTENT_SOURCE=static

# Publica también los lotes con status "draft" (útil en un entorno de preview).
CONTENT_INCLUDE_DRAFTS=false

# ──────────────────────── Solicitudes de muestras ────────────────────────
# Destinos separados por coma: file | console | webhook | email
LEADS_STORE=file,console

# Destino "file": ruta del NDJSON (por defecto .data/leads.ndjson)
# LEADS_FILE=.data/leads.ndjson

# Destino "webhook": Zapier, Make, n8n, Slack o el CRM propio
# LEADS_WEBHOOK_URL=https://hooks.zapier.com/...

# Destino "email": notificación por Resend (https://resend.com)
# RESEND_API_KEY=re_...
# LEADS_EMAIL_TO=comercial@cafelecoin.com
# LEADS_EMAIL_FROM=web@cafelecoin.com
