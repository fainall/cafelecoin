# ─────────────────────────────── Despliegue ───────────────────────────────
# Dominio público del sitio. Manda sobre el valor de src/content/data/contact.ts
# y alimenta metadatos, sitemap, robots y datos estructurados.
# En Vercel: ponlo en Production con el dominio final; en Preview puede quedar
# la URL que asigna Vercel.
NEXT_PUBLIC_SITE_URL=https://www.lecoin.cl

# ─────────────────────────────── Contenido ───────────────────────────────
# Fuente de contenido: "static" (archivos en src/content/data) es la única
# implementación por ahora; el selector existe para enchufar un CMS después.
CONTENT_SOURCE=static

# Publica también los lotes con status "draft" (útil en un entorno de preview).
CONTENT_INCLUDE_DRAFTS=false

# ──────────────────────── Solicitudes de muestras ────────────────────────
# Destinos separados por coma: file | console | webhook | email
# Local: file,console — En Vercel el disco es de solo lectura, así que hay que
# poner email o webhook o las solicitudes se pierden.
LEADS_STORE=file,console

# Destino "file": ruta del NDJSON (por defecto .data/leads.ndjson)
# LEADS_FILE=.data/leads.ndjson

# Destino "webhook": Zapier, Make, n8n, Slack o el CRM propio
# LEADS_WEBHOOK_URL=https://hooks.zapier.com/...

# Destino "email": notificación por Resend (https://resend.com)
# RESEND_API_KEY=re_...
# LEADS_EMAIL_TO=comercial@cafelecoin.com
# LEADS_EMAIL_FROM=web@cafelecoin.com

# ──────────────────────────────── Pedidos ────────────────────────────────
# Destinos separados por coma: file | console | webhook | email
# Igual que los leads: en Vercel el disco es de solo lectura, así que sin
# email o webhook los pedidos se pierden con la rotación de registros.
ORDERS_STORE=file,console
# ORDERS_FILE=.data/pedidos.ndjson
# ORDERS_WEBHOOK_URL=https://...
# ORDERS_EMAIL_TO=pedidos@cafelecoin.com
# ORDERS_EMAIL_FROM=web@cafelecoin.com

# ───────────────────────────────── Cobro ─────────────────────────────────
# Sin PAGOS_PROVEEDOR se elige solo: hay token de Mercado Pago -> se cobra
# por ahí; no lo hay -> el pedido se cierra por WhatsApp. Solo hace falta
# fijarlo para forzar uno de los dos.
# PAGOS_PROVEEDOR=mercadopago
#
# Credenciales de Mercado Pago Chile (panel de desarrolladores, no la clave
# de la cuenta). En Vercel van como variable de entorno, nunca en el código.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
